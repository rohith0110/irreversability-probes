# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/

# agent-only state (never committed)
.claude/
.agents/
.agent/
.codex/
.remember/

# large or regenerable artefacts
results/**/hidden/*.npy
results/**/checkpoint.json
logs/

*.tmp

# dry runs and Modal development output
results/dryrun_*/
results/modal/

# ByteSized32 (no licence published): research use only, never committed or released
data/external/
data/rq5/
upload/

# course material and the private execution plan (not part of the code release)
ADNN_Project_Option_1_Irreversibility.docx
ADNN Irreversibility Project Execution Plan and Agent Handoff.md

# secrets and editor state
.env
.vscode/
.idea/

# hidden states of the ToolEmu pairs (large, regenerable)
results/**/toolemu_hidden/*.npy
# RQ5 model I/O contains ByteSized32 game states (no licence; never redistributed).
# results/<model>/rq5/scores.jsonl keeps the per-transition scores without any game text.
results/**/rq5/nll.jsonl

# LaTeX build output (main.pdf is kept as the submitted report)
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
